# Repozytorium przechowuje i wypakowuje pliki tekstowe z LF, także na Windows
# (Prettier: endOfLine "lf"). Bez tego core.autocrlf=true psuje format:check.
* text=auto eol=lf

# Skrypty Windows wymagają CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Pliki binarne.
*.docx binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff binary
*.woff2 binary
