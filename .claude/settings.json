{
  "permissions": {
    "defaultMode": "auto",
    "additionalDirectories": ["../krajozbior-docs"],
    "allow": [
      "Bash(gh api -X POST repos/*/statuses/* -f state=* -f context=agent-review *)",
      "Bash(gh api -X POST repos/*/statuses/* -f state=* -f context=security-review *)"
    ],
    "deny": [
      "Bash(ssh)",
      "Bash(ssh *)",
      "PowerShell(ssh)",
      "PowerShell(ssh *)",
      "Bash(*ssh.exe*)",
      "PowerShell(*ssh.exe*)",
      "Bash(scp *)",
      "PowerShell(scp *)",
      "Bash(sftp *)",
      "PowerShell(sftp *)",
      "Bash(ssh-add*)",
      "PowerShell(ssh-add*)",
      "Bash(ssh-agent*)",
      "PowerShell(ssh-agent*)",
      "Bash(ssh-keygen*)",
      "PowerShell(ssh-keygen*)",
      "Bash(ssh-keyscan*)",
      "PowerShell(ssh-keyscan*)",
      "Bash(plink*)",
      "PowerShell(plink*)",
      "Bash(pscp*)",
      "PowerShell(pscp*)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Write(~/.ssh/**)",
      "Read(**/krajozbior-deploy/**)",
      "Edit(**/krajozbior-deploy/**)",
      "Write(**/krajozbior-deploy/**)",
      "Edit(.agents/**)",
      "Write(.agents/**)",
      "MultiEdit(.agents/**)",
      "Edit(/.agents/**)",
      "Write(/.agents/**)",
      "MultiEdit(/.agents/**)",
      "Edit(AGENTS.md)",
      "Write(AGENTS.md)",
      "MultiEdit(AGENTS.md)",
      "Edit(/AGENTS.md)",
      "Write(/AGENTS.md)",
      "MultiEdit(/AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "MultiEdit(CLAUDE.md)",
      "Edit(/CLAUDE.md)",
      "Write(/CLAUDE.md)",
      "MultiEdit(/CLAUDE.md)",
      "Edit(scripts/bot-token.ps1)",
      "Write(scripts/bot-token.ps1)",
      "Edit(/scripts/bot-token.ps1)",
      "Write(/scripts/bot-token.ps1)",
      "Read(**/.data/showcase/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Bash(cat .env)",
      "Bash(cat .env.local)",
      "PowerShell(Get-Content .env)",
      "PowerShell(Get-Content .env.local)",
      "Read(**/*.pem)",
      "Read(~/**/*.pem)",
      "Read(~/.config/**)",
      "Edit(**/*.pem)",
      "Edit(~/**/*.pem)",
      "Edit(~/.config/**)",
      "Write(**/*.pem)",
      "Write(~/**/*.pem)",
      "Write(~/.config/**)",
      "Edit(.claude/*)",
      "Edit(.claude/hooks/**)",
      "Edit(.claude/skills/**)",
      "Edit(.claude/agents/**)",
      "Edit(.claude/commands/**)",
      "Write(.claude/*)",
      "Write(.claude/hooks/**)",
      "Write(.claude/skills/**)",
      "Write(.claude/agents/**)",
      "Write(.claude/commands/**)",
      "MultiEdit(.claude/*)",
      "MultiEdit(.claude/hooks/**)",
      "MultiEdit(.claude/skills/**)",
      "MultiEdit(.claude/agents/**)",
      "MultiEdit(.claude/commands/**)",
      "Edit(.claude/rules/**)",
      "Edit(.claude/output-styles/**)",
      "Edit(.mcp.json)",
      "Write(.claude/rules/**)",
      "Write(.claude/output-styles/**)",
      "Write(.mcp.json)",
      "MultiEdit(.claude/rules/**)",
      "MultiEdit(.claude/output-styles/**)",
      "MultiEdit(.mcp.json)",
      "Edit(/.claude/*)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.claude/skills/**)",
      "Edit(/.claude/agents/**)",
      "Edit(/.claude/commands/**)",
      "Edit(/.claude/rules/**)",
      "Edit(/.claude/output-styles/**)",
      "Edit(/.mcp.json)",
      "Write(/.claude/*)",
      "Write(/.claude/hooks/**)",
      "Write(/.claude/skills/**)",
      "Write(/.claude/agents/**)",
      "Write(/.claude/commands/**)",
      "Write(/.claude/rules/**)",
      "Write(/.claude/output-styles/**)",
      "Write(/.mcp.json)",
      "MultiEdit(/.claude/*)",
      "MultiEdit(/.claude/hooks/**)",
      "MultiEdit(/.claude/skills/**)",
      "MultiEdit(/.claude/agents/**)",
      "MultiEdit(/.claude/commands/**)",
      "MultiEdit(/.claude/rules/**)",
      "MultiEdit(/.claude/output-styles/**)",
      "MultiEdit(/.mcp.json)",
      "Bash(git push* main)",
      "Bash(git push* HEAD:main)",
      "PowerShell(git push* main)",
      "PowerShell(git push* HEAD:main)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "Bash(git -C * push* -f*)",
      "Bash(git -C * push* --force*)",
      "PowerShell(git -C * push* -f*)",
      "PowerShell(git -C * push* --force*)",
      "Bash(gh auth token*)",
      "PowerShell(gh auth token*)",
      "Bash(gh auth status*)",
      "PowerShell(gh auth status*)",
      "Bash(gh auth git-credential*)",
      "PowerShell(gh auth git-credential*)",
      "Bash(git credential*)",
      "PowerShell(git credential*)",
      "Bash(*GH_TOKEN=*)",
      "Bash(*GITHUB_TOKEN=*)",
      "Bash(*$GH_TOKEN*)",
      "Bash(*$GITHUB_TOKEN*)",
      "PowerShell(*$env:GH_TOKEN*)",
      "PowerShell(*$env:GITHUB_TOKEN*)",
      "PowerShell(*GH_TOKEN=*)",
      "PowerShell(*GITHUB_TOKEN=*)",
      "Bash(git -c credential*)",
      "Bash(git -C * -c credential*)",
      "Bash(git config*credential.helper*)",
      "PowerShell(git -c credential*)",
      "PowerShell(git -C * -c credential*)",
      "PowerShell(git config*credential.helper*)",
      "Bash(git-credential*)",
      "Bash(*git-credential-*)",
      "PowerShell(git-credential*)",
      "PowerShell(*git-credential-*)",
      "Bash(*GIT_TRACE_REDACT*)",
      "Bash(*GIT_CURL_VERBOSE*)",
      "Bash(*GIT_TRACE_CURL*)",
      "PowerShell(*GIT_TRACE_REDACT*)",
      "PowerShell(*GIT_CURL_VERBOSE*)",
      "PowerShell(*GIT_TRACE_CURL*)",
      "PowerShell(*GetEnvironmentVariable*TOKEN*)",
      "PowerShell(*GetEnvironmentVariables*)",
      "PowerShell(Get-ChildItem env:*)",
      "PowerShell(Get-ChildItem -Path env:*)",
      "PowerShell(gci env:*)",
      "PowerShell(ls env:*)",
      "PowerShell(dir env:*)",
      "Bash(printenv*)",
      "PowerShell(printenv*)",
      "Bash(env)",
      "Bash(env |*)",
      "Bash(env >*)",
      "PowerShell(env)",
      "Bash(set)",
      "Bash(export)",
      "Bash(export -p*)",
      "Bash(declare -p*)",
      "Bash(typeset -p*)",
      "Bash(*/proc/*/environ*)"
    ],
    "ask": [
      "Bash(git push*)",
      "PowerShell(git push*)",
      "Bash(git -C * push*)",
      "PowerShell(git -C * push*)",
      "Bash(git reset --hard*)",
      "PowerShell(git reset --hard*)",
      "Bash(git clean*)",
      "PowerShell(git clean*)",
      "Bash(rm -rf*)",
      "PowerShell(Remove-Item* -Recurse*)",
      "Bash(gh auth login*)",
      "Bash(gh auth switch*)",
      "Bash(gh auth logout*)",
      "PowerShell(gh auth login*)",
      "PowerShell(gh auth switch*)",
      "PowerShell(gh auth logout*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-rls-in-migration.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-env-read.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-key-read.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-pr-merge.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-agent-config.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-shell-file-writes.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-remote-access.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
