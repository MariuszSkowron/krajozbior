# Caddy przed aplikacją (D-E11-2). Domena i certyfikat TLS z Let's Encrypt.
# Nagłówki bezpieczeństwa (CSP, HSTS, Referrer-Policy) ustawia wyłącznie aplikacja.
# Dziennik dostępu jest wyłączony; dziennik błędów idzie do journald (retencja 14 dni).
{
	log {
		level ERROR
	}

	# Jawne limity czasu połączenia (NOWE-1): wolne połączenia nie zajmują gniazd w nieskończoność.
	# Nagłówki 10 s i treść 30 s wystarczą dla formularzy po kilka KB; zapis odpowiedzi 60 s
	# z zapasem ponad limit 15 s zapytania do bazy (#61); bezczynne połączenie 2 min.
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			write 60s
			idle 2m
		}
	}
}

www.krajozbior.pl, http://krajozbior.pl, http://www.krajozbior.pl {
	redir https://krajozbior.pl{uri} permanent
}

krajozbior.pl {
	# Bramka hasła do otwarcia serwisu (spec 5.4a): `gate.caddy` z `basic_auth` na wszystkich
	# ścieżkach poza /api/health kładzie skrypt wdrożenia, a zdejmuje go krok otwarcia
	# (po `npm run legal:final`). Brak pliku (pusty katalog) = serwis otwarty; wzorzec z gwiazdką
	# nie daje błędu, gdy nic nie pasuje.
	import /etc/caddy/gate/*.caddy

	# Treść żądania najwyżej 1 MB (SEC-2): większe Caddy odrzuca kodem 413, zanim trafi do aplikacji.
	# Aplikacja nie przyjmuje plików (zdjęcia wyłączone), a jej formularze mają po kilka KB.
	request_body {
		max_size 1MB
	}

	# Adres klienta bierzemy z połączenia TCP, nie z nagłówka przysłanego przez klienta.
	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
	}
}
