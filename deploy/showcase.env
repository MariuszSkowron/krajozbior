# Zmienne pokazu lokalnego (D-E11-8). Bez sekretów: hasła ról bazy, sekret sesji
# i hasło kont demo generuje scripts/showcase/showcase-up.ps1 do .data/showcase/secrets.env.
# Ten plik dołącza wyłącznie deploy/compose.showcase.yaml; deploy/compose.yaml (serwer) go nie zna.
# Trzy flagi poniżej (ALLOW_DEMO_SEED, DEMO_ACCOUNTS_TEST_ONLY, EMAIL_OUTBOX_TEST_ONLY) są
# dozwolone tylko dlatego, że adres jest lokalny; env.ts odrzuca je pod adresem publicznym.
# AUTH_CLIENT_IP_HEADER celowo nie jest ustawiany: bez pośrednika nagłówek podałaby przeglądarka.
BETTER_AUTH_URL=http://localhost:3300
EMAIL_TRANSPORT=outbox
EMAIL_OUTBOX_DIR=.data/outbox
EMAIL_OUTBOX_TEST_ONLY=1
EMAIL_FROM=noreply@krajozbior.local
ALLOW_DEMO_SEED=1
DEMO_ACCOUNTS_TEST_ONLY=1
