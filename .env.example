# Skopiuj do pliku .env i uzupełnij. Plik .env nie trafia do repozytorium.
# Wartości poniżej dotyczą wyłącznie lokalnej bazy z compose.yaml.

# Administrator klastra (lokalnie superuser `krajozbior` z compose.yaml). Używa go
# wyłącznie `npm run db:roles`, który tworzy role krajozbior_owner, krajozbior_app,
# krajozbior_auth i krajozbior_ops. Nie jest połączeniem aplikacji ani migracji.
DATABASE_ADMIN_URL=postgres://krajozbior:krajozbior@localhost:5432/krajozbior

# Hasła ról bazy (min. 16 znaków każde), ustawiane przez `npm run db:roles`.
# Wygeneruj lokalnie, np. `openssl rand -hex 24`, i wpisz te same wartości
# w adresy połączeń niżej.
KRAJOZBIOR_OWNER_DB_PASSWORD=
KRAJOZBIOR_APP_DB_PASSWORD=
KRAJOZBIOR_AUTH_DB_PASSWORD=
KRAJOZBIOR_OPS_DB_PASSWORD=

# Migracje MikroORM (`npm run db:migrate`) jako właściciel obiektów:
# postgres://krajozbior_owner:<KRAJOZBIOR_OWNER_DB_PASSWORD>@localhost:5432/krajozbior
DATABASE_MIGRATION_URL=
# Aplikacja webowa jako krajozbior_app (bez dostępu do schematu `auth`, podlega RLS):
# postgres://krajozbior_app:<KRAJOZBIOR_APP_DB_PASSWORD>@localhost:5432/krajozbior
DATABASE_URL=
# Adapter tożsamości (Better Auth) i `npm run db:seed:demo` jako krajozbior_auth:
# postgres://krajozbior_auth:<KRAJOZBIOR_AUTH_DB_PASSWORD>@localhost:5432/krajozbior
DATABASE_AUTH_URL=
# Polecenia operatora (`npm run ops:curator`, `npm run auth:create-admin`, role i
# organizacje w `npm run db:seed:demo`) jako krajozbior_ops, jedyna rola zapisująca dziennik operacji:
# postgres://krajozbior_ops:<KRAJOZBIOR_OPS_DB_PASSWORD>@localhost:5432/krajozbior
DATABASE_OPS_URL=


# Sekret sesji Better Auth (min. 32 znaki). Wygeneruj lokalnie, np. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Publiczny adres aplikacji. Lokalnie opcjonalny (domyślnie wyznaczany z żądania).
# W produkcji (NODE_ENV=production) wymagany i tylko https://, bo http:// wyłącza
# atrybut Secure ciasteczka sesji; http:// jest dopuszczony tylko dla localhost/127.0.0.1.
# BETTER_AUTH_URL=https://krajozbior.example

# Nagłówek, w którym zaufane proxy podaje adres IP klienta, dla limitu prób logowania:
# x-real-ip, cf-connecting-ip albo x-forwarded-for (liczy się ostatni wpis).
# Bez niego działa tylko limit per konto. W produkcji z publicznym adresem wymagany.
# AUTH_CLIENT_IP_HEADER=x-real-ip

# Dzienny limit wszystkich próśb o kod logowania w całej aplikacji (domyślnie 250).
# Limity na adres i na IP są stałe (src/features/identity/domain/otp-send-limits.ts).
# OTP_GLOBAL_DAILY_LIMIT=250

# Wspólne hasło lokalnych kont demonstracyjnych (min. 12 znaków), używane tylko
# przez `npm run db:seed:demo`. Konta: user@, user2@, admin@demo.krajozbior.local.
# Seed działa tylko z jawną zgodą ALLOW_DEMO_SEED=1 i tylko na bazie lokalnej.
# Build produkcyjny nie loguje kont demo (wyjątek: testy E2E z DEMO_ACCOUNTS_TEST_ONLY=1
# i adresem lokalnym); nigdy nie ustawiaj tych flag na wspólnym serwerze.
DEMO_ACCOUNT_PASSWORD=
# ALLOW_DEMO_SEED=1

# Hasło nowego administratora dla `npm run auth:create-admin` (min. 16 znaków).
# Ustaw na czas jednego uruchomienia i usuń zaraz potem.
# ADMIN_PASSWORD=

# Wysyłka e-mail (logowanie kodem): `outbox` (domyślnie poza produkcją; plik .eml
# na wiadomość w katalogu ignorowanym przez git, tylko lokalnie i w testach) albo
# `memory` (wiadomości w pamięci procesu, dla testów integracyjnych). Szkielet nie
# ma adaptera produkcyjnego: dodaj go razem z nowym transportem, gdy projekt
# wybierze dostawcę. `outbox` i `memory` konfiguracja odrzuca, gdy BETTER_AUTH_URL
# nie jest adresem lokalnym; build produkcyjny wymaga dodatkowo EMAIL_OUTBOX_TEST_ONLY=1.
# EMAIL_TRANSPORT=outbox
# Ścieżka względna wewnątrz .data/ (inaczej konfiguracja odmawia startu).
# EMAIL_OUTBOX_DIR=.data/email-outbox
# Adres nadawcy (sam adres, bez nazwy); w produkcji wymagany.
# EMAIL_FROM=noreply@krajozbior.example
