{
  "name": "starter",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "cross-env NODE_ENV=production next build",
    "start": "next start",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "cross-env NODE_OPTIONS=--import=tsx vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "db:roles": "tsx --env-file-if-exists=.env ./scripts/db-roles.ts",
    "db:migrate": "tsx --conditions react-server --env-file-if-exists=.env ./node_modules/@mikro-orm/cli/cli.js migration:up",
    "db:migration:create": "tsx --conditions react-server --env-file-if-exists=.env ./node_modules/@mikro-orm/cli/cli.js migration:create",
    "db:seed:demo": "tsx --conditions react-server --env-file-if-exists=.env ./scripts/seed-demo-accounts.ts",
    "auth:throttle": "tsx --conditions react-server --env-file-if-exists=.env ./scripts/auth-throttle.ts",
    "auth:create-admin": "tsx --conditions react-server --env-file-if-exists=.env ./scripts/create-admin.ts",
    "rename-project": "tsx ./scripts/rename-project.ts"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.2.8",
    "@mikro-orm/migrations": "^7.2.8",
    "@mikro-orm/postgresql": "^7.2.8",
    "better-auth": "1.7.19",
    "kysely": "^0.29.8",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.8",
    "@playwright/test": "^1.65.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "axe-core": "4.14.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.9.10",
    "storybook": "^10.6.7",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
